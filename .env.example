# AgentFM Environment Variables
# Copy this to frontend/.env.local and fill in your keys

# Modal endpoint URL (from `modal deploy backend/app.py`)
MODAL_ENDPOINT_URL=

REPLICATE_API_KEY=
# ElevenLabs API key (for TTS, called directly from Next.js API routes)
ELEVENLABS_API_KEY=

# Supermemory API key (for memory queries from Next.js API routes)
SUPERMEMORY_API_KEY=

# Note: ANTHROPIC_API_KEY is only needed in Modal secrets, not here.
# Set it via: modal secret create agentfm-secrets ANTHROPIC_API_KEY=sk-ant-...
