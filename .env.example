# ==============================================================================
# AgentFM Environment Variables
# ==============================================================================
# Two .env.local files exist: backend/.env.local and frontend/.env.local
# Copy the relevant sections below into each.

# ── Backend (backend/.env.local) ─────────────────────────────────────────────

# LLM (Modal vLLM)
MODAL_URL=https://your-modal-deployment-url.modal.run
MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# API Keys
SUPERMEMORY_API_KEY=sm_your_key_here
ELEVENLABS_API_KEY=sk_your_key_here
OPENAI_API_KEY=sk-your_openai_key_here

# ElevenLabs TTS Config
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Server
ORCHESTRATOR_PORT=8001

# ── Frontend (frontend/.env.local) ───────────────────────────────────────────

# Modal endpoint URL (from `modal deploy backend/app.py`)
MODAL_ENDPOINT_URL=https://your-modal-deployment-url.modal.run

# Replicate API key (for sprite generation)
REPLICATE_API_KEY=r8_your_key_here

# ElevenLabs API key (for TTS via Next.js API routes)
ELEVENLABS_API_KEY=sk_your_key_here

# Supermemory API key (for memory queries via Next.js API routes)
SUPERMEMORY_API_KEY=sm_your_key_here

# OpenAI API key (for Whisper voice transcription)
OPENAI_API_KEY=sk-your_openai_key_here

# ── Modal Secrets ────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY is only needed in Modal secrets, not in .env files.
# Set it via: modal secret create agentfm-secrets ANTHROPIC_API_KEY=sk-ant-...
